@page
@{
    ViewData["Title"] = "Mercado Central";
}

<!-- Indica que el documento utiliza HTML5 -->
<!DOCTYPE html>
<!-- Inicio de la página y se indica que el idioma principal es español -->
<html lang="es">
<head>
    <!-- Información general de la página, estilos y configuración -->
    <!-- Permite utilizar correctamente acentos y caracteres especiales -->
    <meta charset="UTF-8">
    <!-- Hace que la página se adapte a celulares, tablets y computadoras -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Título que aparece en la pestaña del navegador -->
    <title>Mercado Central</title>

    <!-- Aquí comienza el diseño visual de la página mediante CSS -->
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f5f6f4;
                color: #26352f;
            }

            /* ===== ENCABEZADO ===== */
            /* Esta sección controla el menú superior, logo, buscador y carrito */

            header {
                background: #173f35;
                color: white;
                position: sticky;
                top: 0;
                z-index: 1000;
                box-shadow: 0 3px 15px rgba(0,0,0,.15);
            }

            .barra {
                width: 92%;
                max-width: 1450px;
                margin: auto;
                min-height: 78px;
                display: flex;
                align-items: center;
                gap: 25px;
            }

            .logo {
                font-size: 25px;
                font-weight: bold;
                white-space: nowrap;
            }

                .logo small {
                    display: block;
                    font-size: 10px;
                    letter-spacing: 2px;
                    color: #d8b45a;
                    margin-top: 3px;
                }

            .buscador {
                flex: 1;
                height: 44px;
                border: none;
                border-radius: 7px;
                padding: 0 18px;
                font-size: 15px;
                outline: none;
            }

            .boton-carrito {
                background: #d8b45a;
                color: #173f35;
                border: none;
                border-radius: 7px;
                height: 44px;
                padding: 0 18px;
                font-weight: bold;
                cursor: pointer;
                white-space: nowrap;
            }

                .boton-carrito:hover {
                    background: #edd184;
                }

            .carrito-panel {
                display: none;
                position: absolute;
                right: 4%;
                top: 70px;
                width: 390px;
                max-width: 92%;
                background: white;
                color: #333;
                border-radius: 10px;
                padding: 20px;
                box-shadow: 0 12px 35px rgba(0,0,0,.25);
            }

                .carrito-panel.activo {
                    display: block;
                }

                .carrito-panel h3 {
                    margin: 0 0 15px;
                    color: #173f35;
                }

            .item {
                display: grid;
                grid-template-columns: 1fr auto auto;
                gap: 10px;
                align-items: center;
                padding: 10px 0;
                border-bottom: 1px solid #e5e5e5;
                font-size: 14px;
            }

            .cantidad button {
                width: 26px;
                height: 26px;
                border: 1px solid #ccc;
                background: white;
                border-radius: 4px;
                cursor: pointer;
            }

            .eliminar {
                border: none;
                background: #a83b3b;
                color: white;
                border-radius: 4px;
                padding: 5px 7px;
                cursor: pointer;
            }

            .total {
                text-align: right;
                font-size: 20px;
                font-weight: bold;
                color: #173f35;
                margin-top: 16px;
            }

            /* ===== CATEGORIAS ===== */
            /* Botones que permiten filtrar los productos por categoría */

            .categorias {
                background: white;
                border-bottom: 1px solid #ddd;
            }

            .categorias-contenido {
                width: 92%;
                max-width: 1450px;
                margin: auto;
                display: flex;
                align-items: center;
                gap: 8px;
                overflow-x: auto;
                padding: 10px 0;
            }

            .categorias button {
                background: white;
                border: 1px solid #d6ddd9;
                color: #38534a;
                border-radius: 20px;
                padding: 9px 15px;
                cursor: pointer;
                white-space: nowrap;
            }

                .categorias button:hover,
                .categorias button.activa {
                    background: #173f35;
                    color: white;
                    border-color: #173f35;
                }

            /* ===== CONTENIDO ===== */
            /* Contenido principal, banner y área donde aparecen los productos */

            .contenedor {
                width: 92%;
                max-width: 1450px;
                margin: 25px auto 50px;
            }

            .hero {
                background: linear-gradient(110deg, #173f35, #286b58);
                min-height: 250px;
                border-radius: 12px;
                color: white;
                padding: 42px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 28px;
            }

            .hero-text {
                max-width: 650px;
            }

            .hero h1 {
                margin: 0 0 10px;
                font-size: 38px;
            }

            .hero p {
                font-size: 17px;
                color: #e7eeeb;
                line-height: 1.5;
            }

            .hero button {
                background: #d8b45a;
                color: #173f35;
                border: none;
                padding: 12px 22px;
                border-radius: 6px;
                font-weight: bold;
                cursor: pointer;
            }

            .hero-badge {
                font-size: 70px;
                padding-right: 50px;
            }

            .titulo {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin: 25px 0 18px;
            }

                .titulo h2 {
                    margin: 0;
                    color: #173f35;
                }

            .contador-productos {
                color: #777;
                font-size: 14px;
            }

            /* ===== PRODUCTOS ===== */
            /* Diseño de cada tarjeta individual de producto */

            .productos {
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                gap: 17px;
            }

            .producto {
                background: white;
                border: 1px solid #e5e9e7;
                border-radius: 9px;
                padding: 13px;
                position: relative;
                transition: .2s;
                min-width: 0;
            }

                .producto:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 22px rgba(0,0,0,.10);
                }

                .producto img {
                    width: 100%;
                    height: 165px;
                    object-fit: cover;
                    border-radius: 7px;
                    background: #f2f3f1;
                }

            .etiqueta {
                position: absolute;
                top: 20px;
                left: 20px;
                background: #b33a3a;
                color: white;
                font-size: 10px;
                font-weight: bold;
                padding: 5px 7px;
                border-radius: 4px;
            }

            .marca {
                color: #8a928e;
                font-size: 11px;
                margin-top: 10px;
            }

            .producto h3 {
                font-size: 15px;
                margin: 5px 0;
                min-height: 35px;
                color: #293a34;
            }

            .presentacion {
                font-size: 12px;
                color: #777;
                min-height: 17px;
            }

            .precio {
                font-size: 20px;
                font-weight: bold;
                color: #173f35;
                margin: 10px 0;
            }

            .precio-anterior {
                color: #999;
                text-decoration: line-through;
                font-size: 12px;
                margin-left: 5px;
            }

            .producto .agregar {
                width: 100%;
                height: 37px;
                border: none;
                background: #173f35;
                color: white;
                border-radius: 5px;
                cursor: pointer;
                font-weight: bold;
            }

                .producto .agregar:hover {
                    background: #286b58;
                }

            .sin-resultados {
                display: none;
                background: white;
                border-radius: 10px;
                text-align: center;
                padding: 50px;
                color: #777;
            }

            /* ===== FOOTER ===== */
            /* Pie de página con información general de la tienda */

            footer {
                background: #173f35;
                color: #dfe8e4;
                padding: 35px 6%;
                margin-top: 50px;
            }

            .footer-contenido {
                max-width: 1450px;
                margin: auto;
                display: flex;
                justify-content: space-between;
                gap: 30px;
                flex-wrap: wrap;
            }

            footer h3 {
                color: white;
                margin-top: 0;
            }

            footer p {
                font-size: 13px;
                color: #bdcbc5;
            }

            /* ===== RESPONSIVE ===== */
            /* Estas reglas adaptan el diseño cuando cambia el tamaño de pantalla */

            @@media (max-width: 1200px) {
                .productos {
                    grid-template-columns: repeat(4, 1fr);
                }
            }

            @@media (max-width: 900px) {
                .productos {
                    grid-template-columns: repeat(3, 1fr);
                }

                .hero-badge {
                    display: none;
                }
            }

            @@media (max-width: 650px) {
                .barra {
                    flex-wrap: wrap;
                    padding: 12px 0;
                }

                .buscador {
                    order: 3;
                    flex-basis: 100%;
                }

                .productos {
                    grid-template-columns: repeat(2, 1fr);
                }

                .hero {
                    padding: 25px;
                }

                    .hero h1 {
                        font-size: 28px;
                    }

                .carrito-panel {
                    top: 120px;
                }
            }

            @@media (max-width: 430px) {
                .productos {
                    grid-template-columns: 1fr;
                }

                .boton-carrito {
                    padding: 0 12px;
                }
            }
    </style>
</head>

<body>

    <!-- ===== CUERPO PRINCIPAL DE LA PÁGINA ===== -->
    <!-- ===== ENCABEZADO PRINCIPAL ===== -->
    <header>
        <div class="barra">

            <!-- Nombre y pequeña descripción de la tienda -->
            <div class="logo">
                Mercado Central
                <small>CALIDAD PARA TU HOGAR</small>
            </div>

            <!-- Campo donde el usuario escribe el producto que desea buscar -->
            <input id="buscador"
                   class="buscador"
                   type="text"
                   placeholder="¿Qué estás buscando? Ej. leche, cereal, jabón..."
                   onkeyup="buscar()">

            <!-- Botón que abre o cierra el carrito de compras -->
            <button class="boton-carrito" onclick="mostrarCarrito()">
                🛒 Carrito (<span id="contador">0</span>)
            </button>

            <!-- Panel desplegable donde se muestran los productos agregados -->
            <div id="carritoPanel" class="carrito-panel">
                <h3>Mi carrito</h3>
                <div id="lista">Tu carrito está vacío.</div>
                <div class="total">
                    Total: $<span id="total">0</span>
                </div>
            </div>

        </div>
    </header>

    <!-- ===== MENÚ DE CATEGORÍAS ===== -->
    <section class="categorias">
        <div class="categorias-contenido">
            <button onclick="categoria('todos')">Todos</button>
            <button onclick="categoria('abarrotes')">Abarrotes</button>
            <button onclick="categoria('frutas')">Frutas</button>
            <button onclick="categoria('verduras')">Verduras</button>
            <button onclick="categoria('lacteos')">Lácteos</button>
            <button onclick="categoria('bebidas')">Bebidas</button>
            <button onclick="categoria('limpieza')">Limpieza</button>
            <button onclick="categoria('higiene')">Higiene</button>
            <button onclick="categoria('botanas')">Botanas</button>
            <button onclick="categoria('congelados')">Congelados</button>
            <button onclick="ofertas()">Ofertas</button>
        </div>
    </section>

    <!-- ===== CONTENIDO PRINCIPAL ===== -->
    <main class="contenedor">

        <!-- Banner principal de bienvenida y ofertas -->
        <section class="hero">
            <div class="hero-text">
                <h1>Todo para tu hogar, en un solo lugar</h1>
                <p>
                    Encuentra alimentos, bebidas, productos de limpieza,
                    higiene y mucho más. Compra fácil y encuentra tus
                    productos rápidamente.
                </p>
                <button onclick="ofertas()">Ver ofertas</button>
            </div>

            <div class="hero-badge">🛒</div>
        </section>

        <!-- Título y cantidad de productos mostrados -->
        <div class="titulo">
            <h2>Productos destacados</h2>
            <span id="contadorProductos" class="contador-productos"></span>
        </div>

        <!-- JavaScript coloca aquí todas las tarjetas de productos -->
        <div id="productos" class="productos"></div>

        <!-- Mensaje que aparece cuando la búsqueda no encuentra productos -->
        <div id="sinResultados" class="sin-resultados">
            <h2>No encontramos ese producto</h2>
            <p>Prueba con otro nombre o selecciona otra categoría.</p>
        </div>

    </main>

    <!-- ===== PIE DE PÁGINA ===== -->
    <footer>
        <div class="footer-contenido">
            <div>
                <h3>Mercado Central</h3>
                <p>Productos para tu hogar con calidad y buen servicio.</p>
            </div>

            <div>
                <h3>Compra fácil</h3>
                <p>Busca productos, selecciona una categoría y agrégalos al carrito.</p>
            </div>

            <div>
                <h3>Atención</h3>
                <p>Lunes a domingo · 8:00 AM - 10:00 PM</p>
            </div>
        </div>
    </footer>

    <script>

            // ===== LÓGICA DE LA TIENDA =====
            // En esta sección se controlan productos, búsqueda, categorías y carrito.

