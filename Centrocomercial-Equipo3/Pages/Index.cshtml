                ["Barra de cereal", "Botanas", "6 piezas", 55, 1, "https://images.unsplash.com/photo-1606313564200-e75d5e30476a?auto=format&fit=crop&w=700&q=85"],

                /* CONGELADOS */
                ["Pizza congelada", "Congelados", "400 g", 89, 1, "https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=700&q=85"],
                ["Helado de vainilla", "Congelados", "1 L", 79, 1, "https://images.unsplash.com/photo-1497034825429-c343d7c6a68f?auto=format&fit=crop&w=700&q=85"],
                ["Verduras congeladas", "Congelados", "500 g", 49, 0, "https://images.unsplash.com/photo-1587334206596-c0f9f7dccbe6?auto=format&fit=crop&w=700&q=85"],
                ["Nuggets de pollo", "Congelados", "500 g", 99, 1, "https://images.unsplash.com/photo-1562967916-eb82221dfb92?auto=format&fit=crop&w=700&q=85"],
                ["Papas a la francesa", "Congelados", "750 g", 72, 0, "https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=700&q=85"],
                ["Hamburguesas", "Congelados", "8 piezas", 115, 1, "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=700&q=85"]
            ];

            // Arreglo donde se guardan temporalmente los productos que el cliente agrega al carrito.
            let carrito = [];
            // Guarda la categoría que actualmente está seleccionada.
            let categoriaActual = "todos";

            // Genera visualmente las tarjetas de productos dentro de la página.
            function mostrarProductos(lista) {
                // Obtiene el elemento HTML donde se mostrarán los productos.
                let contenedor = document.getElementById("productos");
                // Obtiene el mensaje que se mostrará si no hay resultados.
                let sinResultados = document.getElementById("sinResultados");
                // Obtiene el texto que indica cuántos productos se están mostrando.
                let contador = document.getElementById("contadorProductos");

                contenedor.innerHTML = "";

                contador.innerText = lista.length + " productos";

                if (lista.length === 0) {
                    sinResultados.style.display = "block";
                    return;
                }

                sinResultados.style.display = "none";

                lista.forEach(function (p, i) {

                    let oferta = p[4] === 1;
                    let anterior = oferta ? Math.round(p[3] * 1.15) : 0;

                    contenedor.innerHTML +=
                        '<div class="producto">' +

                        (oferta ? '<span class="etiqueta">OFERTA</span>' : '') +

                        '<img src="' + p[5] + '" alt="' + p[0] + '">' +

                        '<div class="marca">' + p[1] + '</div>' +

                        '<h3>' + p[0] + '</h3>' +

                        '<div class="presentacion">' + p[2] + '</div>' +

                        '<div class="precio">$' + p[3] +
                        (oferta ? ' <span class="precio-anterior">$' + anterior + '</span>' : '') +
                        '</div>' +

                        '<button class="agregar" onclick="agregar(' + i + ')">' +
                        'Agregar al carrito' +
                        '</button>' +

                        '</div>';
                });
            }

            // Filtra el catálogo según la categoría seleccionada y lo escrito en el buscador.
            function obtenerLista() {
                let texto = document.getElementById("buscador").value.toLowerCase();

                return productos.filter(function (p) {

                    let coincideCategoria =
                        categoriaActual === "todos" ||
                        p[1].toLowerCase() === categoriaActual;

                    let coincideBusqueda =
                        p[0].toLowerCase().includes(texto) ||
                        p[1].toLowerCase().includes(texto);

                    return coincideCategoria && coincideBusqueda;
                });
            }

            // Se ejecuta al escribir en el buscador y actualiza los resultados.
            function buscar() {
                mostrarProductos(obtenerLista());
            }

            // Cambia la categoría actual y muestra únicamente los productos correspondientes.
            function categoria(tipo) {
                categoriaActual = tipo.toLowerCase();
                mostrarProductos(obtenerLista());
            }

            // Muestra solamente los productos marcados como oferta.
            function ofertas() {
                let texto = document.getElementById("buscador").value.toLowerCase();

                let lista = productos.filter(function (p) {
                    return p[4] === 1 &&
                        (p[0].toLowerCase().includes(texto) ||
                         p[1].toLowerCase().includes(texto));
                });

                categoriaActual = "todos";
                mostrarProductos(lista);
            }

            // Agrega un producto al carrito o aumenta su cantidad si ya existe.
            function agregar(indice) {
                let listaVisible = obtenerLista();
                let producto = listaVisible[indice];

                if (!producto) return;

                let existente = carrito.find(function (p) {
                    return p.nombre === producto[0];
                });

                if (existente) {
                    existente.cantidad++;
                } else {
                    carrito.push({
                        nombre: producto[0],
                        precio: producto[3],
                        cantidad: 1
                    });
                }

                // Inicializa el carrito mostrando que está vacío y establece el contador en cero.
            mostrarCarrito();
                document.getElementById("carritoPanel").classList.add("activo");
            }

            // Aumenta o disminuye la cantidad de un producto dentro del carrito.
            function cambiar(indice, cambio) {
                carrito[indice].cantidad += cambio;

                if (carrito[indice].cantidad <= 0) {
                    carrito.splice(indice, 1);
                }

                mostrarCarrito();
            }

            // Elimina completamente un producto del carrito.
            function eliminar(indice) {
                carrito.splice(indice, 1);
                mostrarCarrito();
            }

            // Actualiza el contenido del carrito, el total y el contador superior.
            function mostrarCarrito() {
                let panel = document.getElementById("carritoPanel");
                panel.classList.toggle("activo");

                let lista = document.getElementById("lista");
                let total = 0;
                let cantidad = 0;

                if (carrito.length === 0) {
                    lista.innerHTML = "Tu carrito está vacío.";
                } else {
                    lista.innerHTML = "";

                    carrito.forEach(function (p, i) {

                        let subtotal = p.precio * p.cantidad;
                        total += subtotal;
                        cantidad += p.cantidad;

                        lista.innerHTML +=
                            '<div class="item">' +

                            '<span>' + p.nombre + '</span>' +

                            '<div class="cantidad">' +
                            '<button onclick="cambiar(' + i + ',-1)">−</button> ' +
                            p.cantidad +
                            ' <button onclick="cambiar(' + i + ',1)">+</button>' +
                            '</div>' +

                            '<strong>$' + subtotal + '</strong>' +

                            '<button class="eliminar" onclick="eliminar(' + i + ')">X</button>' +

                            '</div>';
                    });
                }

                document.getElementById("total").innerText = total;
                document.getElementById("contador").innerText = cantidad;
            }

            // Carga todos los productos automáticamente cuando se abre la página.
            mostrarProductos(productos);
            mostrarCarrito();

    </script>

</body>
</html>

